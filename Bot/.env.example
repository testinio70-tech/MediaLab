# Token creado con @BotFather
TELEGRAM_BOT_TOKEN=PEGA_AQUI_TU_TOKEN

# IDs numéricos permitidos, separados por comas.
# Déjalo vacío para permitir a cualquier usuario.
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# IDs con permisos especiales reservados para funciones futuras.
# Por ahora MediaLab 2.3.0 no usa estas funciones masivas.
TELEGRAM_PRIVILEGED_USER_IDS=123456789

# Cola global: por seguridad se recomienda 1 trabajador.
DOWNLOAD_QUEUE_MAX_SIZE=10
DOWNLOAD_QUEUE_WORKERS=1
MAX_JOBS_PER_USER=1

# Segundos que permanece el mensaje temporal después de un envío exitoso.
STATUS_MESSAGE_DELETE_DELAY=2

# true = Instagram se envía como documentos sin compresión de Telegram.
# false = se envía como álbum visual, pero las fotos pueden comprimirse.
INSTAGRAM_SEND_ORIGINALS_AS_DOCUMENTS=true

# Nombre o ruta completa de ffprobe.
FFPROBE_BINARY=ffprobe
